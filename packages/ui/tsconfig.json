{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}
